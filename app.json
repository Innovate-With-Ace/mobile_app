{
  "expo": {
    "name": "Beboy's Eatery",
    "slug": "beboys_mobile_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/beboys_logo.png",
    "scheme": "beboysmobileapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/beboys_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/beboys_logo.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/beboys_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#84cc16",
          "dark": {
            "backgroundColor": "#84cc16"
          }
        }
      ],
      "expo-font",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
